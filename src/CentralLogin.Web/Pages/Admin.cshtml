@page
@model AdminModel
@{
    ViewData["Title"] = "Administration";
}

<h1>Administration</h1>
<p>This page is protected by the <code>RequireAdministrator</code> policy and is
only reachable by users holding the Keycloak <code>administrator</code> role.</p>

<div class="card">
    <h2>Administrator-only area</h2>
    <p>Signed in as <strong>@(User.Identity?.Name ?? "unknown")</strong>.</p>
</div>
