<Project Sdk="Microsoft.NET.Sdk">

  <!--
    .NET Aspire AppHost — the local development entry point.
    Orchestrates the Web application, Keycloak (official container image) and
    the planned PostgreSQL database for Keycloak. Secrets are supplied via
    Aspire parameters, never hardcoded here.
  -->
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.4.6" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CentralLogin.AppHost</RootNamespace>
    <AssemblyName>CentralLogin.AppHost</AssemblyName>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>centrallogin-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CentralLogin.Web\CentralLogin.Web.csproj" />
  </ItemGroup>

</Project>
