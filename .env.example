# =====================================================================
# CentralLogin — example environment file (PLACEHOLDERS ONLY)
# =====================================================================
# Copy to `.env` (which is gitignored) and fill in real values locally.
# NEVER commit a populated .env file.
#
# In local development, prefer Aspire parameters / .NET user-secrets over
# this file. This file documents the variables the system understands.
# ---------------------------------------------------------------------

# --- Keycloak (development) ------------------------------------------
# Bootstrap admin for the Keycloak container. Used ONLY to log into the
# Keycloak admin console locally. Not stored in SQLite. Not an app user.
KEYCLOAK_ADMIN_USERNAME=CHANGE_ME_admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_use_a_strong_local_password

# The confidential client secret for `central-login-web`.
# Leave blank locally to have it injected via Aspire parameter / user-secrets.
# Rotate in the Keycloak admin console (see README > Keycloak).
CENTRALLOGIN_WEB_CLIENT_SECRET=

# --- Web application --------------------------------------------------
# Directory where the SQLite database file is stored (persistent).
CENTRALLOGIN_DATA_DIR=./data

# --- Pulumi (production/staging deploys — set in CI, not here) --------
# PULUMI_ACCESS_TOKEN=       # provided by CI secret, do not put here
# CLOUD_PROVIDER_CREDENTIALS=  # provided by CI secret / OIDC, do not put here
